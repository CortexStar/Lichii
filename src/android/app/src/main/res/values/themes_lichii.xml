<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lichii" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lichii_cream</item>
        <item name="android:windowSplashScreenBackground">@color/lichii_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/lichii_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Lichii.Emulation" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <color name="lichii_cream">#FFFBF4E8</color>
</resources>
